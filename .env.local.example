# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets to this .example file.

# WhatsApp floating chat button — country code + number, no +, no spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
# KEY_SECRET is server-only and must never be exposed to the client.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the same Key ID, re-exposed for the
# frontend checkout widget (see app/checkout/page.js).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay webhook — Dashboard -> Settings -> Webhooks -> Add new webhook.
#   URL:    https://<your-domain>/api/webhooks/razorpay
#   Event:  payment.captured
#   Secret: any random string you choose; paste the same value here.
RAZORPAY_WEBHOOK_SECRET=

# Supabase (order + subscriber + contact storage) — https://supabase.com
# Run supabase/schema.sql in the SQL Editor first.
# Project Settings -> API. The service-role key bypasses Row Level Security,
# so it is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails) — https://resend.com/api-keys
# EMAIL_FROM must use a domain verified in Resend to reach customers; until
# then leave it unset (sandbox sender only delivers to your own Resend email).
RESEND_API_KEY=
EMAIL_FROM="Parkolyn Amsterdam <orders@parkolyn.com>"
# Where new-order alerts and contact-form messages are sent.
ORDER_ALERT_EMAIL=

# Public URL of the site, used for the "open in admin" link in new-order emails.
# Optional: on Vercel the production domain is detected automatically.
# SITE_URL=https://www.parkolyn.com
