# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets to this .example file.

# WhatsApp floating chat button — country code + number, no +, no spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
# KEY_SECRET is server-only and must never be exposed to the client.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the same Key ID, re-exposed for the
# frontend checkout widget (see app/checkout/page.js).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
